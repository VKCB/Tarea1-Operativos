  2312                                  ; Funcion: update_bot_direction
  2313                                  ; Actualiza la direccion del bot segun la posicion actual
  2314                                  ; Return:
  2315                                  ;   void
  2316                                  update_bot_direction:
  2317 000021C4 488B05(180A0000)            mov rax, [bot_position]       ; Cargar la posición actual del bot
  2318                                  
  2319                                      ; Verificar si el bot está en el límite inferior del tablero
  2320 000021CB 483D[440A0000]              cmp rax, board + ((column_cells + 2) * (row_cells - 1))  ; Límite inferior
  2321 000021D1 7D19                        jge .change_direction_up      ; Si está en el límite inferior, cambiar dirección a "arriba"
  2322                                  
  2323                                      ; Verificar si el bot está en el límite superior del tablero
  2324 000021D3 483D[34000000]              cmp rax, board
  2325 000021D9 7E1D                        jle .change_direction_down    ; Si está en el límite superior, cambiar dirección a "abajo"
  2326                                  
  2327                                      ; Verificar si el bot está en el límite derecho del tablero
  2328 000021DB 483D[A1000000]              cmp rax, board + column_cells - 1
  2329 000021E1 7D21                        jge .change_direction_left    ; Si está en el límite derecho, cambiar dirección a "izquierda"
  2330                                  
  2331                                      ; Verificar si el bot está en el límite izquierdo del tablero
  2332 000021E3 483D[34000000]              cmp rax, board
  2333 000021E9 7E25                        jle .change_direction_right   ; Si está en el límite izquierdo, cambiar dirección a "derecha"
  2334                                  
  2335 000021EB C3                          ret                           ; Si no hay cambios, salir de la función
  2336                                  
  2337                                  	.change_direction_up:
  2338 000021EC 48C705(39000000)02-     		mov qword [bot_direction], up_direction
  2338 000021F4 000000             
  2339 000021F7 C3                      		ret
  2340                                  
