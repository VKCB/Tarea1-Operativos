  2354                                  ; Funcion: change_bot_direction
  2355                                  ; Genera una dirección aleatoria para el bot
  2356                                  ; Return:
  2357                                  ;   void
  2358                                  change_bot_direction:
  2359                                      ; Incrementar el estado de la ruta
  2360 0000221C 8A05(42000000)              mov al, [bot_path_state]
  2361 00002222 FEC0                        inc al
  2362 00002224 3C08                        cmp al, 8        ; Si llegamos al final del recorrido (8 estados)
  2363 00002226 7C02                        jl .no_reset
  2364 00002228 30C0                        xor al, al       ; Reiniciar el estado a 0
  2365                                  	.no_reset:
  2366 0000222A 8805(42000000)          		mov [bot_path_state], al
  2367                                  		
  2368                                  		; Seleccionar dirección según el estado de la ruta
  2369 00002230 3C00                    		cmp al, 0
  2370 00002232 741C                    		je .set_right    ; Estado 0: Derecha
  2371                                  		
  2372 00002234 3C01                    		cmp al, 1
  2373 00002236 743C                    		je .set_up       ; Estado 1: Arriba
  2374                                  		
  2375 00002238 3C02                    		cmp al, 2
  2376 0000223A 742C                    		je .set_left     ; Estado 2: Izquierda
  2377                                  		
  2378 0000223C 3C03                    		cmp al, 3
  2379 0000223E 741C                    		je .set_down     ; Estado 3: Abajo
  2380                                  		
  2381 00002240 3C04                    		cmp al, 4
  2382 00002242 740C                    		je .set_right    ; Estado 4: Derecha
  2383                                  		
  2384 00002244 3C05                    		cmp al, 5
  2385 00002246 742C                    		je .set_up       ; Estado 5: Arriba
  2386                                  		
  2387 00002248 3C06                    		cmp al, 6
  2388 0000224A 741C                    		je .set_left     ; Estado 6: Izquierda
  2389                                  		
  2390 0000224C 3C07                    		cmp al, 7
  2391 0000224E 7400                    		je .set_right    ; Estado 7: Derecha (hacia el punto inicial)
  2392                                  		
  2393                                      ; Si ninguna de las anteriores coincide, establecer dirección a la derecha
  2394                                      .set_right:
