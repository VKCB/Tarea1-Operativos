   911                                  ; Funcion generar un numero aleatorio entre 100 y 150 para la velocidad 
   912                                  generate_random:
   913                                      ; Abrir /dev/urandom para leer un byte aleatorio
   914 00000A9C 57                      	push rdi
   915 00000A9D 56                      	push rsi
   916 00000A9E 52                      	push rdx
   917 00000A9F 50                      	push rax
   918                                  
   919 00000AA0 B800000000                  mov rax, 0                ; sys_read
   920 00000AA5 48BF-                       mov rdi, urandom          ; Descriptor de archivo para /dev/urandom
   920 00000AA7 [0000000000000000] 
   921 00000AAF 48BE-                       mov rsi, random_value     ; Dirección donde se guarda el byte aleatorio
   921 00000AB1 [0E00000000000000] 
   922 00000AB9 BA01000000                  mov rdx, 1                ; Leer 1 byte
   923 00000ABE 0F05                        syscall                   ; Llamada al sistema para leer
   924                                  
   925                                      ; Reducir el rango del número aleatorio a 0-49
   926 00000AC0 480FB605(0E000000)          movzx rax, byte [random_value]  ; Cargar el byte aleatorio en rax
   927 00000AC8 4831D2                      xor rdx, rdx              ; Limpiar rdx para la division
   928 00000ACB B932000000                  mov rcx, 50               ; Divisor (rango deseado: 50 numeros)
   929 00000AD0 48F7F1                      div rcx                   ; rax = rax / rcx, rdx = rax % rcx
   930                                      ; Ahora rdx contiene el número aleatorio en el rango 0-49
   931                                  
   932                                      ; Ajustar el rango base a 100-150
   933 00000AD3 4883C264                    add rdx, 100 ; suma 100 para obtener el rango deseado
   934                                  
   935                                      ; Guardar el resultado en una variable o registro
   936 00000AD7 488915(21000000)            mov [random_result], rdx  ; Guardar el número aleatorio generado
   937                                  
   938 00000ADE 5F                      	pop rdi
   939 00000ADF 5E                      	pop rsi
   940 00000AE0 5A                      	pop rdx
   941 00000AE1 58                      	pop rax
   942                                  
   943 00000AE2 C3                          ret
   944                                  
   945                                  ; Funcion: generate_random_low
   946                                  ; Genera un número aleatorio entre 0 y 10
   947                                  ; Return:
   948                                  ;   rdx: Número aleatorio en el rango 0-10
   949                                  generate_random_low:
   950                                      ; Abrir /dev/urandom para leer un byte aleatorio
   951 00000AE3 57                          push rdi
   952 00000AE4 56                          push rsi
   953 00000AE5 52                          push rdx
   954 00000AE6 50                          push rax
   955                                  
   956 00000AE7 B800000000                  mov rax, 0                ; sys_read
   957 00000AEC 48BF-                       mov rdi, urandom          ; Descriptor de archivo para /dev/urandom
   957 00000AEE [0000000000000000] 
   958 00000AF6 48BE-                       mov rsi, random_value     ; Dirección donde se guarda el byte aleatorio
   958 00000AF8 [0E00000000000000] 
   959 00000B00 BA01000000                  mov rdx, 1                ; Leer 1 byte
   960 00000B05 0F05                        syscall                   ; Llamada al sistema para leer
   961                                  
   962                                      ; Reducir el rango del número aleatorio a 0-10
   963 00000B07 480FB605(0E000000)          movzx rax, byte [random_value]  ; Cargar el byte aleatorio en rax
   964 00000B0F 4831D2                      xor rdx, rdx              ; Limpiar rdx para la división
   965 00000B12 B904000000                  mov rcx, 4               ; Divisor (rango deseado: 11 números, de 0 a 10)
   966 00000B17 48F7F1                      div rcx                   ; rax = rax / rcx, rdx = rax % rcx
   967                                      ; Ahora rdx contiene el número aleatorio en el rango 0-10
   968                                  
   969                                      ; Guardar el resultado en una variable o registro
   970 00000B1A 488915(21000000)            mov [random_result], rdx  ; Guardar el número aleatorio generado
   971                                  
   972 00000B21 5F                          pop rdi
   973 00000B22 5E                          pop rsi
   974 00000B23 5A                          pop rdx
   975 00000B24 58                          pop rax
   976                                  
   977 00000B25 C3                          ret
   978                                  
   979                                  ; Función: set_bot_speed
   980                                  ; Establece la velocidad del bot de manera aleatoria
   981                                  set_bot_speed:
   982 00000B26 52                      	push rdx
   983                                  	; Llamar a la funcion para generar numero random
   984 00000B27 E870FFFFFF              	call generate_random
   985                                  	; ; Guardar el numero aleatorio en la variable de velocidad del bot
   986                                  	; mov [bot_speed], rdx ; Guardar el número aleatorio generado en bot_speed
   987                                  
   988                                  	; pop rdx
   989                                  	; ret
   990                                  	; Invertir el valor (mayor número = mayor velocidad)
   991 00000B2C B896000000                  mov rax, 150                ; Valor máximo
   992 00000B31 4829D0                      sub rax, rdx                ; Restar el número generado (100-150)
   993 00000B34 4883C064                    add rax, 100                ; Ajustar nuevamente al rango 50-100
   994 00000B38 488905(29000000)            mov [bot_speed], rax        ; Guardar el número invertido
   995 00000B3F 5A                          pop rdx
   996 00000B40 C3                          ret
   997                                  
   998                                  
   999                                  ; Función: move_bot
  1000                                  ; Mueve el bot en la dirección definida
  1001                                  ; Return:
  1002                                  ;   void
  1003                                  move_bot:
  1004                                  
  1005 00000B41 50                      	push rax
  1006 00000B42 51                      	push rcx
  1007                                  
  1008 00000B43 4C8B1D(680A0000)        	mov r11, [colj]              ; Cargar el valor de la variable `colj` en r11
  1009 00000B4A 4983FB01                	cmp r11, 1                   ; Comparar el valor de `colj` con 1
  1010 00000B4E 0F8460070000            	je .endp                     ; Si `colj` es igual a 1, saltar al final de la función
  1011                                      
  1012 00000B54 4883FF02                	cmp rdi, up_direction					; Comparar el valor de rdi (dirección) con left_direction
  1013 00000B58 7423                    	je .move_up						; Si no es igual a left_direction, saltar a .move_right
  1014                                  
  1015 00000B5A 4883FF03                	cmp rdi, down_direction
  1016 00000B5E 0F8476020000            	je .move_down
  1017                                  
  1018 00000B64 4883FF01                	cmp rdi, right_direction
  1019 00000B68 0F8477060000            	je .move_right
  1020                                  
  1021 00000B6E 4883FFFF                	cmp rdi, left_direction
  1022 00000B72 0F84C2040000            	je .move_left
  1023                                  
  1024                                  	; Si no coincide con ninguna dirección, salir
