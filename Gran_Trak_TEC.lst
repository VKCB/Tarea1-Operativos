   324                                  		ICANON:         equ 1<<1		;Canonico la entrada no se envía al programa hasta que el usuario presiona Enter
   325                                  		ECHO:           equ 1<<3		;Bandera que habilita o deshabilita este modo
   326                                  		VTIME: 			equ 5
   327                                  		VMIN:			equ 6
   328                                  		CC_C:			equ 18
