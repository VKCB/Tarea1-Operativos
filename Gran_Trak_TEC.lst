   410 000002C5 BA[D4090000]                    mov edx, termios
   411 000002CA CD80                            int 80h
   412                                  
   413 000002CC 5A                              pop rdx
   414 000002CD 59                              pop rcx
   415 000002CE 5B                              pop rbx
   416 000002CF 58                              pop rax
   417 000002D0 C3                              ret
   418                                  
   419                                  write_stdin_termios:								;Escribe los atributos del terminal utilizando la llamada al sistema 
   420 000002D1 50                              push rax
