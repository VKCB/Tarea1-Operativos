   352                                  section .text
   353                                  ;;;;;;;;;;;;;;;;;;;;for the working of the terminal;;;;;;;;;;;;;;;;;
   354                                  canonical_off:										;La entrada se procese carácter por carácter sin esperar a que se presione Enter.
   355 0000023E E86F000000                      call read_stdin_termios						;Guarda los atributos actuales del terminal en la variable termios
   356                                  
   357                                          ; clear canonical bit in local mode flags	
   358 00000243 50                              push rax						
   359 00000244 B802000000                      mov eax, ICANON								;Carga el valor de la constante ICANON (que representa el bit del modo canónico) en eax
   360 00000249 F7D0                            not eax										;Niega todos los bits en eax
   361 0000024B 2105(E0090000)                  and [termios+12], eax						;Limpia el bit canónico en las banderas de modo local
   362 00000251 C605(EB090000)00        		mov byte[termios+CC_C+VTIME], 0				;Establecen VTIME y VMIN en 0 para que el terminal no espere caracteres adicionales
   363 00000258 C605(EC090000)00        		mov byte[termios+CC_C+VMIN], 0
   364 0000025F 58                              pop rax
   365                                  
   366 00000260 E86C000000                      call write_stdin_termios					;Escribe los atributos modificados de termios de vuelta al terminal
   367 00000265 C3                              ret
   368                                  
   369                                  echo_off:											;No se muestran los caracteres introducidos
   370 00000266 E847000000                      call read_stdin_termios
   371                                  
   372                                          ; clear echo bit in local mode flags
   373 0000026B 50                              push rax
   374 0000026C B808000000                      mov eax, ECHO
   375 00000271 F7D0                            not eax
   376 00000273 2105(E0090000)                  and [termios+12], eax
   377 00000279 58                              pop rax
   378                                  
   379 0000027A E852000000                      call write_stdin_termios
   380 0000027F C3                              ret
   381                                  
   382                                  canonical_on:										;La entrada se procesa en líneas completas. Espera hasta que el usuario presione Enter
   383 00000280 E82D000000                      call read_stdin_termios
   384                                  
   385                                          ; set canonical bit in local mode flags
   386 00000285 830D(E0090000)02                or dword [termios+12], ICANON
   387 0000028C C605(EB090000)00        		mov byte[termios+CC_C+VTIME], 0			;Tiempo en decisegundos que el terminal espera para la entrada.
   388 00000293 C605(EC090000)01        		mov byte[termios+CC_C+VMIN], 1			;El número mínimo de caracteres que se deben leer
   389 0000029A E832000000                      call write_stdin_termios
   390 0000029F C3                              ret
   391                                  
   392                                  echo_on:											;Se muestran los caracteres introducidos
   393 000002A0 E80D000000                      call read_stdin_termios
   394                                  
   395                                          ; set echo bit in local mode flags
   396 000002A5 830D(E0090000)08                or dword [termios+12], ECHO
   397                                  
   398 000002AC E820000000                      call write_stdin_termios
   399 000002B1 C3                              ret
   400                                  
   401                                  read_stdin_termios:									;Lee los atributos del terminal y los guarda en la variable termios
   402 000002B2 50                              push rax
   403 000002B3 53                              push rbx
   404 000002B4 51                              push rcx
   405 000002B5 52                              push rdx
   406                                  
   407 000002B6 B836000000                      mov eax, 36h
   408 000002BB BB00000000                      mov ebx, stdin
